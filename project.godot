; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RedrawTheWorld"
run/main_scene="uid://biv54y4eif17v"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
run/stdout/print_fps=true

[autoload]

EventBus="*res://Manager/EventBus.gd"
InventoryManager="*res://Manager/InventoryManager.gd"
UIManager="*res://Manager/UIManager.gd"
SceneManager="*res://Manager/SceneManager.gd"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"
GameManager="*res://Manager/GameManager.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/always_on_top=true
window/stretch/mode="canvas_items"

[editor]

script/templates_search_path="res://ScriptTemplates"

[editor_plugins]

enabled=PackedStringArray("res://addons/better-terrain/plugin.cfg")

